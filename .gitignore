# --- Rust ---
/target/
**/*.rs.bk
*.pdb

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# The compiled extension module is a build artifact, never committed.
*.so
*.pyd
*.dylib

# --- maturin / uv ---
# uv.lock and Cargo.lock ARE committed - reproducible builds need them.
# build/ and dist/ are not.
/build/
/dist/
/wheels/

# --- mdBook ---
docs/book/

# --- editors / OS ---
.DS_Store
*.swp
*~
.idea/
.vscode/

# --- release artifacts ---
# provenance.json is generated per release and, once signed, attached to the
# release alongside the wheels - which is where a signature is useful, since a
# committed copy would be a second, unsigned, silently-stale record of the same
# thing. CI generates one per build and uploads it as an artifact for review.
/provenance.json

# --- local scratch ---
/tmp/
*.local.*
