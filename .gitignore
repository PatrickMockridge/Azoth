# --- Rust ---
/target/
**/*.rs.bk
*.pdb

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# The compiled extension module is a build artifact, never committed.
*.so
*.pyd
*.dylib

# --- maturin / uv ---
# uv.lock and Cargo.lock ARE committed - reproducible builds need them.
# build/ and dist/ are not.
/build/
/dist/
/wheels/

# --- mdBook ---
docs/book/

# --- Lean ---
# `.lake` holds the compiled oleans and the packages Lake fetched, which for
# Mathlib is several gigabytes. `lake build` reproduces it from the pins in
# `lean/lake-manifest.json`, which IS committed - that is what makes the
# toolchain and the dependency revisions reproducible rather than merely
# recorded.
lean/.lake/
lean/vendor/lean-units/.lake/

# --- Java (the NeqSim oracle driver, compiled by hand, never committed) ---
*.class

# --- editors / OS ---
.DS_Store
*.swp
*~
.idea/
.vscode/

# --- release artifacts ---
# provenance.json is generated per release and, once signed, attached to the
# release alongside the wheels - which is where a signature is useful, since a
# committed copy would be a second, unsigned, silently-stale record of the same
# thing. CI generates one per build and uploads it as an artifact for review.
/provenance.json

# --- user-supplied licensed data ---
# Your own data file, and the data files generated from it, are yours. Committing
# values that came from a standard you licensed would redistribute them, which is
# the thing the copyright rule exists to avoid - see docs/src/copyright.md. The
# committed copies under data/ must keep the placeholders, which is why the
# generated files are NOT listed here: gitignore cannot untrack a file that is
# already committed, so that rule is `tools/gen_user_data.py`'s to announce and
# yours to respect rather than something this file can do.
/azoth-data.toml

# --- local scratch ---
/tmp/
*.local.*
