{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PatrickMockridge/Azoth/main/specs/schema/component.schema.json",
  "title": "Component parameters",
  "description": "The parameters a keycard may state for one component, and the canonical unit each is converted to. This is the single declaration the two implementations and the keycard schema hold themselves to, so a parameter one carries and another does not is a test failure rather than a drift.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Tc": {
      "$ref": "#/$defs/parameter",
      "x-azoth-unit": "K",
      "x-azoth-column": "tc_k",
      "description": "Critical temperature."
    },
    "Pc": {
      "$ref": "#/$defs/parameter",
      "x-azoth-unit": "Pa",
      "x-azoth-column": "pc_pa",
      "description": "Critical pressure."
    },
    "omega": {
      "$ref": "#/$defs/parameter",
      "x-azoth-unit": "dimensionless",
      "x-azoth-column": "acentric_factor",
      "description": "Acentric factor."
    },
    "cp_a": {
      "$ref": "#/$defs/parameter",
      "x-azoth-unit": "J/(mol*K)",
      "x-azoth-column": "cpa",
      "description": "Ideal-gas heat-capacity constant term."
    },
    "cp_b": {
      "$ref": "#/$defs/parameter",
      "x-azoth-unit": "J/(mol*K**2)",
      "x-azoth-column": "cpb",
      "description": "Ideal-gas heat-capacity linear coefficient."
    },
    "cp_c": {
      "$ref": "#/$defs/parameter",
      "x-azoth-unit": "J/(mol*K**3)",
      "x-azoth-column": "cpc",
      "description": "Ideal-gas heat-capacity quadratic coefficient."
    },
    "cp_d": {
      "$ref": "#/$defs/parameter",
      "x-azoth-unit": "J/(mol*K**4)",
      "x-azoth-column": "cpd",
      "description": "Ideal-gas heat-capacity cubic coefficient."
    },
    "cp_e": {
      "$ref": "#/$defs/parameter",
      "x-azoth-unit": "J/(mol*K**5)",
      "x-azoth-column": "cpe",
      "description": "Ideal-gas heat-capacity quartic coefficient."
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "citation": { "$ref": "calc.schema.json#/$defs/citation" },
        "value": { "type": "number" },
        "unit": { "$ref": "calc.schema.json#/$defs/unit" }
      }
    }
  }
}
