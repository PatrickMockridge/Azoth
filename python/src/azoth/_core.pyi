    components: list[str]
    z: list[float]
    n: float
    p: float
    t: float
    h: float
    def __init__(self, components: list[str], z: list[float], n: float, p: float, t: float) -> None: ...
    @staticmethod
    def from_ph(components: list[str], z: list[float], n: float, p: float, h: float) -> Stream: ...

