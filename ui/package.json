{
  "name": "azoth-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The azoth flowsheet editor: the middleware's first front-end.",
  "scripts": {
    "wasm": "wasm-pack build ../crates/azoth-wasm --target web --out-dir ../../ui/src/wasm/pkg --release",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.11"
  }
}
